# ── Site ──────────────────────────────────────────────
# Public site URL — used for canonical URLs, sitemap.xml and social/OpenGraph
# link previews (WhatsApp, X, Facebook, LinkedIn, iMessage, etc.).
#
# IMPORTANT: set this to the exact URL you'll SHARE. If the preview image
# doesn't appear on WhatsApp, it's almost always because this doesn't match
# the live URL. On Vercel it auto-falls back to your deployment URL, so
# previews work even before you connect a custom domain — but setting it
# explicitly is best.
NEXT_PUBLIC_SITE_URL=https://bevyirie.com

# ── Contact form (SMTP / Nodemailer) ──────────────────
# Any SMTP provider works: your domain's mailbox, Gmail (app password),
# Zoho, Brevo, Mailgun SMTP, etc. Without SMTP_HOST/USER/PASS the contact
# form runs in "demo mode": submissions validate and succeed, and are
# logged server-side (no email is sent).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
# Leave blank to auto-infer (true only for port 465). Set "true"/"false" to force.
SMTP_SECURE=
SMTP_USER=info@bevyirie.com
SMTP_PASS=your-smtp-password-or-app-password
# From address on outgoing mail (defaults to "Bevy Irie <SMTP_USER>").
CONTACT_FROM_EMAIL="Bevy Irie <info@bevyirie.com>"
# Where new enquiries are delivered (defaults to info@bevyirie.com).
CONTACT_TO_EMAIL=info@bevyirie.com

# ── Analytics (optional) ──────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=

# ── Private owner dashboard (/admin) ──────────────────
# Passcode to access your private visitor-analytics dashboard at /admin.
# REQUIRED in production. In development a fallback ("bevyirie-admin") is used
# if this is unset, so you can try it locally.
ADMIN_PASSCODE=
# Optional: a separate secret used to sign the admin session cookie.
# Defaults to ADMIN_PASSCODE if unset. Use a long random string in production.
ADMIN_SESSION_SECRET=
# Owner identity shown in the dashboard.
ADMIN_EMAIL=info@bevyirie.com

# ── Visitor analytics storage ─────────────────────────
# Storage priority: Upstash Redis (if set) → encrypted file on disk → in-memory
# demo data (fallback when the filesystem is read-only, e.g. Vercel).
#
# Encrypted file (default): visits are written to a server-side text file where
# each line is AES-256-GCM encrypted + authenticated, so the data can't be read
# or tampered with without this secret. Set a long random value in production.
ANALYTICS_SECRET=
# Where the encrypted visit log is written (default: ./.data/visits.txt).
# On a serverless host use an absolute writable path or prefer Upstash below.
ANALYTICS_DATA_FILE=
#
# Optional: Upstash Redis for durable, multi-instance storage (recommended on
# serverless/Vercel). Create a free DB at https://upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
