# ── Site ──────────────────────────────────────────────
# Public site URL — used for canonical URLs, sitemap.xml and social/OpenGraph
# link previews (WhatsApp, X, Facebook, LinkedIn, iMessage, etc.).
#
# IMPORTANT: set this to the exact URL you'll SHARE. If the preview image
# doesn't appear on WhatsApp, it's almost always because this doesn't match
# the live URL. On Vercel it auto-falls back to your deployment URL, so
# previews work even before you connect a custom domain — but setting it
# explicitly is best.
NEXT_PUBLIC_SITE_URL=https://bevyirie.com

# ── Contact form (SMTP / Nodemailer) ──────────────────
# Any SMTP provider works: your domain's mailbox, Gmail (app password),
# Zoho, Brevo, Mailgun SMTP, etc. Without SMTP_HOST/USER/PASS the contact
# form runs in "demo mode": submissions validate and succeed, and are
# logged server-side (no email is sent).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
# Leave blank to auto-infer (true only for port 465). Set "true"/"false" to force.
SMTP_SECURE=
SMTP_USER=info@bevyirie.com
SMTP_PASS=your-smtp-password-or-app-password
# From address on outgoing mail (defaults to "Bevy Irie <SMTP_USER>").
CONTACT_FROM_EMAIL="Bevy Irie <info@bevyirie.com>"
# Where new enquiries are delivered (defaults to info@bevyirie.com).
CONTACT_TO_EMAIL=info@bevyirie.com

# ── Analytics (optional) ──────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=
